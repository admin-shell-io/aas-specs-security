skinparam shadowing false
skinparam ArrowColor #444444
hide footbox

actor "Economic operator\n(tenant)" as User
participant "Service-provider IAM" as IAM #FFF2CC
participant "Service-provider\nDPP service" as DPP #FFF2CC
participant "Service-provider\nAAS service" as AAS #D9EAF7

User -> DPP : Create, read, or update DPP data
DPP -> IAM : Authenticate tenant economic operator
IAM --> DPP : AAS token with role and tenant claim
DPP -> AAS : Create, read, or update tenant AAS data\nwith trusted token
AAS -> AAS : Select trusted tenant partition\nExample 7: check role and tenant;\nauthorize CREATE, READ, or UPDATE
AAS --> DPP : Requested or changed tenant data
DPP --> User : DPP result
@enduml
