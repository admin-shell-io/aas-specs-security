skinparam shadowing false
skinparam ArrowColor #444444
hide footbox

actor "External DPP\nservice provider" as Provider
participant "IAM trusted by the\neconomic operator AAS" as IAM #FFF2CC
participant "Economic-operator\nAAS service" as AAS #D9EAF7

Provider -> IAM : Obtain authenticated AAS token
IAM --> Provider : Token for DPP service-provider role\nwith update authorization when applicable
alt Read DPP data
  Provider -> AAS : Read DPP Submodels with token
  AAS -> AAS : Validate trusted token\nExample 5: authorize READ
  AAS --> Provider : Permitted DPP data
else Update Product Condition
  Provider -> AAS : Update Product Condition with token
  AAS -> AAS : Validate trusted token\nExample 6: check update permission\nand delegated object scope
  AAS --> Provider : Updated Product Condition data
end
@enduml
