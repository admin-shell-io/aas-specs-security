<AccessRuleModel> ::=
    <AllAccessPermissionRules> |
    <ResourceBoundAccessRuleModels>

<AllAccessPermissionRules> ::=
    <AllAccessPermissionDefs>
    ( <AccessPermissionRule> <Ws> )*

<ResourceBoundAccessRuleModels> ::=
    <ResourceBoundAccessRuleModel> <Ws>
    ( <ResourceBoundAccessRuleModel> <Ws> )*

<ResourceBoundAccessRuleModel> ::=
    "RESOURCE:" <Ws> <SingleObject> <Ws>
    <ResourceBoundAccessPermissionDefs>
    ( <ResourceBoundAccessPermissionRule> <Ws> )*

<ResourceBoundAccessPermissionDefs> ::=
    <AllAccessDefAttributes>
    <AllAccessDefAcls>
    <AllAccessDefFormulas>

<AllAccessPermissionDefs> ::=
    <AllAccessDefAttributes>
    <AllAccessDefAcls>
    <AllAccessDefObjects>
    <AllAccessDefFormulas>

<AllAccessDefAttributes> ::=
    ( "DEFATTRIBUTES" <Ws> <StringLiteral> <Ws> <AttributeGroup> <Ws> )*

<AllAccessDefAcls> ::=
    ( "DEFACLS" <Ws> <StringLiteral> <Ws> <ACL> <Ws> )*

<AllAccessDefObjects> ::=
    ( "DEFOBJECTS" <Ws> <StringLiteral> <Ws> <ObjectGroup> <Ws> )*

<AllAccessDefFormulas> ::=
    ( "DEFFORMULAS" <Ws> <StringLiteral> <Ws> <LogicalExpression> <Ws> )*

<AccessPermissionRule> ::=
    <AccessAccessRule>
    <AccessObjects>
    <AccessFormula>
    <Filter>

<ResourceBoundAccessPermissionRule> ::=
    <AccessAccessRule>
    <AccessFormula>
    <Filter>

<AccessAccessRule> ::=
    "ACCESSRULE:" <Ws> ( <ACL> | <UseACL> ) <Ws>

<AccessObjects> ::=
    "OBJECTS:" <Ws>
    ( <SingleObject> <Ws> )*
    ( <UseObjectGroup> <Ws> )*

<AccessFormula> ::=
    ( "FORMULA:" <Ws> <LogicalExpression> <Ws> ) |
    ( <UseFormula> <Ws> )

<Filter> ::=
    (
        ( "FILTER:" <Ws> <SecurityQueryFilter> <Ws> )?
        ( "FILTERLIST:" <Ws> ( <SecurityQueryFilter> <Ws> )* )?
    )

<SecurityQueryFilter> ::=
    ( "FRAGMENT:" <Ws> <FieldIdentifierFragment> <Ws> )
    (
        ( "CONDITION:" <Ws> <LogicalExpression> <Ws> ) |
        ( <UseFormula> <Ws> )
    )
